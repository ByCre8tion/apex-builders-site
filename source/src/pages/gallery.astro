---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Ph from '../components/Ph.astro';
import CtaBand from '../components/CtaBand.astro';
import { gallery, galleryCats } from '../data/site';
---
<Base title="Gallery | Apex Builders" description="Photos of kitchens, bathrooms, living spaces, exteriors and commercial work by Apex Builders." current="gallery.html">
  <PageHeader n="03" label="Gallery" title="Every room we have touched" edit="gallery" lead="Browse by room. Select a photo to see it full screen." />
  <section class="section" aria-label="Photo gallery" style="padding-top:0">
    <div class="wrap">
      <div class="filters" data-filters="#galGrid" role="group" aria-label="Filter photos">
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        {galleryCats.map((c) => <button type="button" data-filter={c} aria-pressed="false">{c}</button>)}
        <span class="filter-count" aria-live="polite"></span>
      </div>
      <div class="gal-grid" id="galGrid">
        {gallery.map((g) => (
          <figure class:list={['gal-item', g.shape]} data-cat={g.cat} data-label={g.label}>
            <Ph slot={g.slot} alt={g.label} label={g.label} spec={g.cat} />
            <button type="button" class="gal-open"><span class="sr-only">Open {g.label} full screen</span></button>
            <figcaption><span>{g.cat}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <dialog class="viewer" id="viewer" aria-label="Photo viewer">
    <img alt="" />
    <p class="viewer-cap"></p>
    <button type="button" class="v-btn v-prev" aria-label="Previous photo">←</button>
    <button type="button" class="v-btn v-next" aria-label="Next photo">→</button>
    <button type="button" class="v-btn v-close" aria-label="Close viewer">Close</button>
  </dialog>
  <CtaBand edit="gal-cta" title="See something you like?" />
</Base>
<style is:global>
.gal-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:clamp(180px,18vw,280px);grid-auto-flow:dense;gap:12px}
.gal-item{position:relative;margin:0}
.gal-item.tall{grid-row:span 2}
.gal-item.wide{grid-column:span 2}
.gal-item .ph{position:absolute;inset:0}
.gal-open{position:absolute;inset:0;z-index:4;border-radius:var(--r-photo);cursor:zoom-in}
.gal-item:not(:has(.ph-asset)) .gal-open{cursor:default}
.gal-item figcaption{position:absolute;left:12px;bottom:12px;z-index:3;pointer-events:none}
.gal-item figcaption span{display:inline-block;padding:6px 10px;border-radius:999px;background:var(--white);font-size:0.75rem;font-weight:500;letter-spacing:.08em}
.gal-item .ph:not(.has-media)~figcaption{display:none}
.editing .gal-open{display:none}
.viewer{width:100vw;height:100dvh;max-width:none;max-height:none;margin:0;padding:clamp(56px,6vw,80px) clamp(16px,6vw,96px);border:0;background:rgba(17,19,20,.96);color:var(--plaster)}
.viewer[open]{display:grid;grid-template-rows:minmax(0,1fr) auto;place-items:center;gap:16px}
.viewer img{max-width:100%;max-height:100%;object-fit:contain;border-radius:var(--r-photo)}
.viewer-cap{font-size:0.875rem;color:var(--plaster-2)}
.v-btn{position:absolute;min-width:48px;height:48px;padding:0 14px;border-radius:var(--r-btn);border:1px solid rgba(245,238,233,.3);color:var(--plaster);font-size:1.125rem;--focus:var(--orange)}
.v-prev{left:16px;top:50%;transform:translateY(-50%)}
.v-next{right:16px;top:50%;transform:translateY(-50%)}
.v-close{right:16px;top:16px;font-size:0.875rem;font-weight:600}
.viewer::backdrop{background:rgba(17,19,20,.6)}
@media (max-width:900px){ .gal-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:clamp(160px,40vw,260px)} }
</style>
