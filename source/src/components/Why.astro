---
import Ph from './Ph.astro';
import Label from './Label.astro';
import Drawing from './Drawing.astro';
const rows = [{ c: '01', n: 'Scope and plans' }, { c: '06', n: 'Framing and structure' }, { c: '09', n: 'Finishes and fixtures' }, { c: 'AL', n: 'Allowances' }, { c: 'CO', n: 'Possible changes' }];
const phases = [{ n: 'Site walk', s: 0, e: 1 }, { n: 'Design', s: 1, e: 3 }, { n: 'Pricing', s: 3, e: 4 }, { n: 'Permits', s: 4, e: 6 }, { n: 'Build', s: 6, e: 11 }, { n: 'Walkthrough', s: 11, e: 12 }];
---
<section class="why section has-draw" aria-labelledby="why-h">
  <Drawing n={1} class="draw-why" />
  <div class="wrap">
    <div class="head" data-reveal><Label n="04" text="Why Apex" /><h2 id="why-h" data-edit="why-title">Doing it once.<br />Properly.</h2></div>
    <div class="bento">
      <div class="cell media" data-reveal><Ph slot="why-video" kind="video" parallax alt="Behind the scenes on an Apex job" label="Behind the scenes: crew framing, Jason walking the site" spec="4:5, muted loop" /></div>
      <div class="cell orange" data-reveal>
        <div class="num" data-count="2016" data-from="2000">2016</div>
        <p data-edit="why-year">Building and renovating homes in Arizona since 2016, and in the trade here since 2008.</p>
      </div>
      <div class="cell soft" data-reveal>
        <div class="doc sched" id="tracker" aria-hidden="true">
          <div class="doc-top"><b>Schedule</b><span>Sheet A3</span></div>
          <div class="sched-body">
            <div class="sched-wk">{Array.from({ length: 12 }, (_, i) => <span>{i + 1}</span>)}</div>
            {phases.map((p) => <div class="sched-row" data-s={p.s} data-e={p.e}><span class="sched-name">{p.n}</span><span class="sched-lane"><i style={`--s:${p.s / 12};--e:${p.e / 12}`}></i></span></div>)}
            <span class="sched-now"><em>Today</em></span>
          </div>
        </div>
        <h3 data-edit="why-a-t">You always know what is next</h3>
        <p data-edit="why-a-p">One point of contact, regular updates and answers before you have to chase them.</p>
      </div>
      <div class="cell photo on-dark" data-reveal>
        <Ph slot="why-detail" parallax alt="" label="Close up of finish work or framing detail" spec="Landscape" />
        <h3 data-edit="why-b-t">Raw materials. Clean finish.</h3>
        <p data-edit="why-b-p">What is behind the walls matters as much as what you see. We build it right, not just make it look right.</p>
      </div>
      <div class="cell soft" data-reveal>
        <div class="doc est" id="estimate" aria-hidden="true">
          <div class="doc-top"><b>Estimate</b><span>Itemized</span></div>
          <ul>{rows.map((r) => <li><span class="code">{r.c}</span><span>{r.n}</span><i class="ld"></i><span class="inc">Included</span></li>)}</ul>
          <span class="stamp">In writing</span>
        </div>
        <h3 data-edit="why-c-t">Clear, detailed estimates</h3>
        <p data-edit="why-c-p">Every job is quoted in writing. Allowances and possible changes are explained before work starts.</p>
      </div>
    </div>
  </div>
</section>
<style is:global>
.draw-why{top:clamp(0px,4vw,60px)}
.draw-why img{margin-inline:auto -6%}
.bento{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr) minmax(0,1fr);gap:12px}
.cell{border-radius:var(--r-photo);overflow:hidden;position:relative;padding:clamp(22px,2.4vw,34px);display:flex;flex-direction:column;justify-content:flex-end;gap:12px;min-height:320px}
.cell p{max-width:36ch}
.cell.media{grid-row:span 2;padding:0;min-height:640px}
.cell.media .ph{position:absolute;inset:0}
.cell.orange{background:var(--orange);color:var(--ink);--focus:var(--ink)}
.cell.orange .num{font-family:var(--display);font-weight:700;font-variant-numeric:tabular-nums;font-size:clamp(5.5rem,9vw,9.375rem);line-height:.82}
.cell.orange p{font-weight:500;max-width:28ch}
.cell.soft{background:var(--chalk);justify-content:flex-start}
.cell.soft h3{margin-top:auto}
.cell.soft p{color:var(--ink-2)}
.cell.photo>.ph{position:absolute;inset:0;z-index:0}
.cell.photo::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(17,19,20,.2) 0%,rgba(17,19,20,.7) 40%,rgba(17,19,20,.94))}
.cell.photo h3,.cell.photo p{position:relative;z-index:2}
.cell.photo p{color:var(--plaster-2)}
/* Widgets read like printed job documents: graph paper, a title block, a stamp */
.doc{position:relative;background-color:var(--white);background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:14px 14px;background-position:-1px -1px;border:1px solid var(--rule);border-radius:var(--r-btn);padding:0 0 14px;margin-bottom:28px;--grid:rgba(25,28,29,.045)}
.doc-top{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid var(--ink);background:var(--white);font-size:0.75rem;font-variant-numeric:tabular-nums;color:var(--muted)}
.doc-top b{font-size:0.6875rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--ink)}
.sched-body{position:relative;padding:26px 14px 0}
.sched-wk,.sched-row{display:grid;grid-template-columns:86px 1fr;align-items:center}
.sched-wk{grid-template-columns:86px repeat(12,1fr);font-size:0.625rem;font-weight:500;color:var(--muted);font-variant-numeric:tabular-nums;padding-bottom:6px;border-bottom:1px dashed var(--rule)}
.sched-wk span:first-child{grid-column:2}
.sched-row{height:24px;font-size:0.75rem;font-weight:500;color:var(--muted);transition:color .3s ease-out}
.sched-lane{position:relative;height:100%}
.sched-lane i{position:absolute;top:8px;bottom:8px;left:calc(var(--s)*100%);width:calc((var(--e) - var(--s))*100%);background:var(--stone);border-radius:1px;overflow:hidden}
.sched-lane i::after{content:"";position:absolute;inset:0;background:var(--ink);transform:scaleX(var(--p,0));transform-origin:left}
.sched-row.on{color:var(--ink)}
.sched-row.now .sched-lane i::after{background:var(--orange)}
.sched-now{position:absolute;top:22px;bottom:0;left:calc(14px + 86px + (100% - 28px - 86px)*var(--t,0));width:0;border-left:1.5px solid var(--orange);pointer-events:none}
.sched-now em{position:absolute;top:-18px;left:-1px;transform:translateX(-50%);font-style:normal;font-size:0.5625rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ember);background:var(--white);padding:0 3px}
.est{padding-bottom:34px}
.est ul{list-style:none;margin:0;padding:6px 14px 0}
.est li{display:flex;align-items:baseline;gap:10px;padding:6px 0;font-size:0.875rem;font-weight:500;border-bottom:1px dashed var(--rule)}
.est .code{width:22px;font-family:var(--display);font-weight:700;font-size:0.8125rem;letter-spacing:.04em;color:var(--ember);font-variant-numeric:tabular-nums}
.est .ld{flex:1}
.est .inc{font-size:0.6875rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);opacity:0;transform:translateX(-6px);transition:opacity .35s ease-out,transform .35s ease-out}
.est.play .inc{opacity:1;transform:none}
.est li:nth-child(2) .inc{transition-delay:.15s}.est li:nth-child(3) .inc{transition-delay:.3s}.est li:nth-child(4) .inc{transition-delay:.45s}.est li:nth-child(5) .inc{transition-delay:.6s}
.stamp{position:absolute;right:14px;bottom:-16px;padding:6px 12px;border:2px solid var(--ember);border-radius:var(--r-btn);background:var(--white);color:var(--ember);font-family:var(--display);font-weight:700;font-size:1rem;letter-spacing:.12em;text-transform:uppercase;transform:rotate(-7deg) scale(1.6);opacity:0;transition:transform .35s cubic-bezier(.3,1.4,.5,1) .9s,opacity .2s ease-out .9s}
.est.play .stamp{transform:rotate(-7deg);opacity:1}
@media (prefers-reduced-motion:reduce){.est .inc,.stamp{transition:none}}
@media (max-width:1100px){
  .bento{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
  .cell.media{grid-column:1/-1;grid-row:auto;min-height:440px}
}
@media (max-width:640px){ .bento{grid-template-columns:minmax(0,1fr)} .cell{min-height:260px} }
</style>
