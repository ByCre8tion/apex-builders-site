---
import Ph from './Ph.astro';
import Label from './Label.astro';
---
<section class="statement section" aria-label="What we believe">
  <div class="wrap statement-grid">
    <div class="statement-copy">
      <Label n="01" text="What we believe" />
      <p id="statement" data-edit="statement">Great construction starts with <span class="hl">trust.</span> Quality craftsmanship, honest communication and attention to detail, from the first conversation to the final walkthrough.</p>
      <div class="statement-foot" data-reveal>
        <div class="sig"><Ph slot="sig" class="sig-ph" alt="" /><div><b data-edit="sig-name">Jason</b><span data-edit="sig-role">Owner and founder</span></div></div>
        <a class="link" href="about.html">Read our story <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
    <Ph slot="statement" class="statement-ph" parallax alt="Construction plans for an Apex custom home" label="Jason on site walking a client through the work" spec="4:5, vertical" />
  </div>
</section>
<style is:global>
.statement-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(32px,5vw,96px);align-items:center}
.statement-copy{display:flex;flex-direction:column;gap:28px}
#statement{font-family:var(--display);font-weight:600;font-size:clamp(2.125rem,4.4vw,4.375rem);line-height:1.1;max-width:20ch;letter-spacing:-.005em}
#statement .hl{color:var(--ember)}
#statement .w{display:inline-block}
.statement-ph{aspect-ratio:4/5}
.statement-foot{display:flex;flex-wrap:wrap;gap:20px 40px;align-items:center;margin-top:12px}
.sig{display:flex;align-items:center;gap:14px;color:var(--muted);font-size:0.9375rem}
.sig-ph{width:52px;height:52px;border-radius:50%}
.sig b{display:block;color:var(--ink);font-weight:600}
.sig span{display:block}
@media (max-width:900px){ .statement-grid{grid-template-columns:minmax(0,1fr)} .statement-ph{aspect-ratio:4/3} }
</style>
