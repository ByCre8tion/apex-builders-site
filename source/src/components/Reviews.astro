---
import Label from './Label.astro';
import data from '../data/reviews.json';
const star = Array.from({ length: 5 });
---
<section class="reviews section" aria-labelledby="rev-h">
  <div class="wrap">
    <div class="head-row reviews-head" data-reveal>
      <div class="head" style="margin:0">
        <Label n="07" text="Reviews" />
        <h2 id="rev-h" data-edit="rev-title">In their words</h2>
        <a class="link" href={data.url} target="_blank" rel="noopener">{data.rating.toFixed(1)} stars from {data.total} Google reviews<span class="sr-only"> (opens in a new tab)</span> <span class="arr" aria-hidden="true">→</span></a>
        {data.placeholder && <p class="rv-note">Placeholder: these are {data.placeholder} reviews from Google, shown until the Apex Builders profile is connected.</p>}
      </div>
      <div class="arrows">
        <button type="button" id="rvPrev" aria-label="Previous review"><svg viewBox="0 0 20 20" aria-hidden="true" style="transform:scaleX(-1)"><path d="M4 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
        <button type="button" id="rvNext" aria-label="Next review"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
      </div>
    </div>
    <div class="rv-viewport" id="rvViewport" role="region" aria-roledescription="carousel" aria-label="Client reviews" tabindex="0">
      <div class="rv-track" id="rvTrack">
        {data.reviews.map((r) => (
          <article class="review">
            <div class="stars" role="img" aria-label={`${r.rating} out of 5 stars`}>{star.map(() => <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 1.8 2.5 5.3 5.8.7-4.3 4 1.1 5.7L10 14.7l-5.1 2.8L6 11.8l-4.3-4 5.8-.7z" fill="currentColor" /></svg>)}</div>
            <q>{r.text}</q>
            <div class="who"><b>{r.author}</b><span>{r.when} on Google</span></div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
<style is:global>
.reviews{overflow:hidden}
.reviews-head{margin-bottom:clamp(32px,3.6vw,52px)}
.rv-note{font-size:0.8125rem;color:var(--muted);max-width:52ch}
.arrows{display:flex;gap:10px}
.arrows button{width:52px;height:52px;border-radius:var(--r-btn);border:1px solid var(--rule-strong);display:grid;place-items:center;transition:background-color .25s ease-out,transform .15s ease-out}
.arrows button:not(:disabled):active{transform:scale(.96)}
.arrows svg{width:20px;height:20px}
@media (hover:hover){ .arrows button:hover{background:var(--chalk)} }
.rv-viewport{cursor:grab;touch-action:pan-y;user-select:none;-webkit-user-select:none}
.rv-viewport.dragging{cursor:grabbing}
.rv-track{display:flex;gap:16px}
.review{flex:0 0 auto;width:clamp(290px,34vw,480px);border-radius:var(--r-photo);background:var(--white);border:1px solid var(--rule);padding:28px;display:flex;flex-direction:column;gap:18px}
.stars{display:flex;gap:3px;color:var(--orange)}
.stars svg{width:16px;height:16px}
.review q{quotes:"\201C" "\201D";font-family:var(--display);font-weight:600;font-size:clamp(1.375rem,1.9vw,1.6875rem);line-height:1.25}
.who{margin-top:auto;font-size:0.875rem;color:var(--muted)}
.who b{display:block;color:var(--ink);font-weight:600}
@media (max-width:640px){ .review{width:84vw} }
</style>
