---
import Ph from './Ph.astro';
import Label from './Label.astro';
import { faq, contact } from '../data/site';
---
<section class="faq section chalk" id="faq" aria-labelledby="faq-h">
  <div class="wrap faq-grid">
    <div class="faq-side" data-reveal>
      <Label n="08" text="Questions" />
      <h2 id="faq-h" data-edit="faq-title">What people ask us first</h2>
      <Ph slot="faq" alt="" label="Finished bathroom or kitchen detail" spec="4:5" />
    </div>
    <div class="faq-list" id="faqList">
      {faq.map((f, i) => (
        <div class:list={['qa', { open: i === 0 }]}>
          <h3 class="qa-h"><button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`qa-${i}`} id={`qb-${i}`}><span data-edit={`faq-${i}-q`}>{f.q}</span><span class="pm" aria-hidden="true"></span></button></h3>
          <div class="qa-a" id={`qa-${i}`} role="region" aria-labelledby={`qb-${i}`}><div><p data-edit={`faq-${i}-a`}>{f.a}</p></div></div>
        </div>
      ))}
      <a class="link faq-all" href="faq.html">All questions <span class="arr" aria-hidden="true">→</span></a>
      <div class="faq-cta"><p data-edit="faq-cta">Still have a question?</p><a class="btn btn-primary" href={`tel:${contact.tel}`}>Call {contact.phone}</a></div>
    </div>
  </div>
</section>
