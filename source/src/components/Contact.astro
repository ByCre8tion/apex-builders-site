---
import Ph from './Ph.astro';
import Socials from './Socials.astro';
import BbbSeal from './BbbSeal.astro';
import Label from './Label.astro';
import Drawing from './Drawing.astro';
import { contact, projectTypes, budgets, sources } from '../data/site';
const { n = '09', heading = 'Let’s talk about your project' } = Astro.props as { n?: string; heading?: string };
---
<section class="contact section has-draw" id="contact" aria-labelledby="contact-h">
  <Drawing n={2} class="draw-contact" />
  <div class="wrap contact-grid">
    <div class="contact-side">
      <div class="contact-copy">
        <Label n={n} text="Contact" />
        <h2 id="contact-h" data-reveal data-edit="contact-title">{heading}</h2>
        <a class="phone" href={`tel:${contact.tel}`} data-reveal>{contact.phone}</a>
        <div class="contact-lines" data-reveal>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <span>{contact.address}</span>
          <Socials />
          <small>Or comment BUILD on Instagram <a href={`https://www.instagram.com/${contact.instagram}/`} target="_blank" rel="noopener">@{contact.instagram}<span class="sr-only"> (opens in a new tab)</span></a></small>
        </div>
      </div>
      <Ph slot="contact" class="contact-ph" parallax alt="A finished Apex interior" label="Finished home exterior or interior, wide" spec="4:3 or wider" />
    </div>
    <form class="form" id="quoteForm" novalidate data-validate>
      <div id="formFields" class="form-fields">
        <h3>Get a quote</h3>
        <p class="req-note">Fields marked * are required.</p>
        <div class="row2">
          <div class="field"><label for="f-name">Full name <span aria-hidden="true">*</span></label><input id="f-name" name="name" autocomplete="name" required aria-describedby="e-name" data-msg="Add your name so we know who to ask for." /><span class="err" id="e-name"></span></div>
          <div class="field"><label for="f-phone">Phone <span aria-hidden="true">*</span></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="e-phone" data-msg="Add a 10 digit phone number so we can call you back." /><span class="err" id="e-phone"></span></div>
        </div>
        <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" spellcheck="false" /></div>
        <div class="row2">
          <div class="field"><label for="f-type">Project type</label><select id="f-type" name="type">{projectTypes.map((t) => <option>{t}</option>)}</select></div>
          <div class="field"><label for="f-budget">Budget</label><select id="f-budget" name="budget">{budgets.map((t) => <option>{t}</option>)}</select></div>
        </div>
        <div class="field"><label for="f-source">How did you hear about us?</label><select id="f-source" name="source"><option value="">Choose one</option>{sources.map((t) => <option>{t}</option>)}</select></div>
        <div class="field"><label for="f-msg">Tell us about it</label><textarea id="f-msg" name="msg" rows="3" placeholder="Rooms, goals, timing"></textarea></div>
        <input type="hidden" name="utm_source" /><input type="hidden" name="utm_campaign" /><input type="hidden" name="lead_source_tag" />
        <div class="form-submit"><button class="btn btn-primary" type="submit">Get a quote <span class="arr" aria-hidden="true">→</span></button><BbbSeal /></div>
        <p class="form-note">We will call you to set up a site walk.</p>
      </div>
      <div class="form-done" id="formDone" hidden>
        <h3 tabindex="-1">Request received</h3>
        <p>Thanks. Someone from the Apex team will call you to set up a site walk.</p>
      </div>
    </form>
  </div>
</section>
