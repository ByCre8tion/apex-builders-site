---
import { footerCompany, services, contact } from '../data/site';
const year = 2026;
---
<footer class="footer on-dark">
  <div class="wrap foot-grid">
    <div><a class="brand" href="index.html"><img src="brand/logo.svg" alt="" width="38" height="38" />Apex Builders</a><p class="foot-about">Custom homes, renovations, design build and commercial TI across the Valley since 2016.</p></div>
    <div><h2 class="foot-h">Services</h2><ul>{services.map((s) => <li><a href={`services.html#${s.slug}`}>{s.title}</a></li>)}</ul></div>
    <div><h2 class="foot-h">Company</h2><ul>{footerCompany.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
    <div><h2 class="foot-h">Contact</h2><ul><li><a href={`tel:${contact.tel}`}>{contact.phone}</a></li><li><a href={`mailto:${contact.email}`}>{contact.email}</a></li><li>Chandler, AZ 85224</li><li><a href={`https://www.instagram.com/${contact.instagram}/`} target="_blank" rel="noopener">@{contact.instagram}<span class="sr-only"> (opens in a new tab)</span></a></li></ul></div>
  </div>
  <div class="wrap"><div class="foot-mark" id="footMark" aria-hidden="true"><span>A</span><span>P</span><span>E</span><span>X</span></div></div>
  <div class="wrap"><div class="foot-base"><span>© {year} Apex Builders LLC. ROC #{contact.roc}.</span><span>Licensed, bonded and insured</span></div></div>
</footer>
<style is:global>
.footer{background:var(--ink);padding-top:clamp(64px,7vw,104px);overflow:hidden}
.foot-grid{display:grid;grid-template-columns:minmax(0,1.6fr) repeat(3,minmax(0,1fr));gap:32px;padding-bottom:clamp(40px,5vw,72px)}
.foot-about{margin-top:16px;color:#A9ADAE;max-width:34ch}
.foot-h{margin:0 0 14px;font-family:var(--body);font-size:0.875rem;font-weight:600;line-height:1.3;color:#A9ADAE}
.footer ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
@media (hover:hover){ .footer ul a:hover{color:var(--orange)} }
.foot-mark{font-family:var(--display);font-weight:700;text-transform:uppercase;font-size:clamp(7.5rem,27vw,26.25rem);line-height:.78;display:flex;justify-content:space-between;color:#24292A;user-select:none;overflow:hidden;padding-top:.04em}
.foot-mark span{display:inline-block}
.foot-base{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding-block:22px;border-top:1px solid rgba(245,238,233,.12);color:#A9ADAE;font-size:0.8125rem}
@media (max-width:1100px){ .foot-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)} }
@media (max-width:640px){ .foot-grid{grid-template-columns:minmax(0,1fr)} }
</style>
